# Set these in the Vercel project settings (Production + Preview), not in a
# committed .env file. Never expose either value to the browser.

# The private webhook on app.goleadsyncs.com that wraps the "LeadSync sells
# LeadSync" demo agent's Playground engine. Exact path is that project's call.
APP_WEBHOOK_URL=https://app.goleadsyncs.com/api/public/demo-agent

# Shared secret sent as the X-Demo-Relay-Secret header on every forwarded
# request. Must match the value the app-side webhook checks against.
DEMO_RELAY_SHARED_SECRET=change_me_to_a_long_random_value
